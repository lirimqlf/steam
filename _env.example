# Copy to _env and fill in values
# Get the webhook: Discord server → Settings → Integrations → Webhooks → New Webhook → Copy URL

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Auto-scan interval in hours (0 = disabled, trigger from UI only)
SCAN_INTERVAL_HOURS=24

# SQLite path — leave default locally; Render sets this to /data/games.db automatically
# DB_PATH=games.db
